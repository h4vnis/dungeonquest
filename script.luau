local function C_16()
local script = G2L["16"];
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Workspace = game:GetService("Workspace")
	
	local HelperFunctions = require(script.Parent.HelperFunctions)
	local Configs = require(script.Parent.Config)
	
	local Config = Configs.Configs
	
	local dungeon = Workspace:WaitForChild("dungeon")
	local initialRoom = dungeon:WaitForChild("initialRoom")
	local playerSpawn = initialRoom:FindFirstChild("playerSpawn")
	
	local safe
	
	if playerSpawn then
		safe = playerSpawn.CFrame
	else
		safe = Players.LocalPlayer.Character.UpperTorso.CFrame
	end
	
	function v2()
		local dungeon = Workspace.dungeon
	
		HelperFunctions.startRound()
	
		while Config.V2 == true do
			local cooldown = Config.CD or 1
			local duration = Config.Dur or 6
				
			local currentTarget = HelperFunctions.findAnyModel(dungeon)
	
			if currentTarget then
				local attackStart = os.clock()
	
				while currentTarget.Parent and os.clock() - attackStart < duration do
					if Config.V2 == false then
						return
					end
	
					local character = Players.LocalPlayer.Character
					local root = character and HelperFunctions.getRoot(character)
					local otherRoot = HelperFunctions.getTorso(currentTarget)
	
					if not otherRoot or not otherRoot:IsA("BasePart") then
						local bossRoom = dungeon:FindFirstChild("bossRoom")
						local enemyFolder = bossRoom and bossRoom:FindFirstChild("enemyFolder")
	
						local dragon = enemyFolder and enemyFolder:FindFirstChild("Enchanted Forest Dragon")
	
						if dragon then
							otherRoot =
								dragon:FindFirstChild("HumanoidRootPart", true)
								or dragon:FindFirstChild("UpperTorso", true)
								or dragon:FindFirstChild("Torso", true)
								or dragon:FindFirstChildWhichIsA("BasePart", true)
						end
	
						if not otherRoot or not otherRoot:IsA("BasePart") then
							otherRoot = CFrame.new(
								-1311.32703, 15.598999, 646.460999,
								0, 0, -1,
								0, 1, 0,
								1, 0, 0
							)
						end
					end
	
					if root and otherRoot then
						if typeof(otherRoot) == "CFrame" then
							root.CFrame = otherRoot
						else
							root.CFrame = otherRoot.CFrame
						end
	
						HelperFunctions.useSkills()
						HelperFunctions.swingWeapon()
					end
					task.wait()
				end
	
				local cooldownStart = os.clock()
	
				while os.clock() - cooldownStart < cooldown do
					if Config.V2 == false then
						return
					end
	
					local character = Players.LocalPlayer.Character
					local root = character and HelperFunctions.getRoot(character)
	
					if root then
						root.CFrame = safe
					end
	
					task.wait()
				end
			else
				task.wait(1)
	
				if not HelperFunctions.findAnyModel(dungeon) then
					HelperFunctions.restartRound()
					return
				end
			end
		end
	end
	
	local running = false
	
	while true do
		if Config.V2 == true and not running then
			running = true
	
			task.spawn(function()
				v2()
				running = false
			end)
		end
	
		task.wait(0.1)
	end
end;
