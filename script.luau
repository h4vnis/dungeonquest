local function C_15()
local script = G2L["15"];
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Workspace = game:GetService("Workspace")
	
	local HelperFunctions = require(script.Parent.HelperFunctions)
	local Configs = require(script.Parent.Config)
	
	local Config = Configs.Configs
	
	local attacking = false
	
	local function spamAttacks()
		if attacking then
			return
		end
	
		attacking = true
	
		while Config.V1 == true do
			HelperFunctions.useSkills()
			HelperFunctions.swingWeapon()
			task.wait(0.25)
		end
	
		attacking = false
	end
	
	local characterConnection
	
	Players.LocalPlayer.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid")
		task.wait(1)
	
		if Config.V1 == true then
			task.spawn(spamAttacks)
		end
	end)
	
	local function v1()
		local dungeon = Workspace:WaitForChild("dungeon")
	
		HelperFunctions.startRound()
		
		task.spawn(spamAttacks)
		
		local emptySince = nil
	
		while Config.V1 == true do
			local currentTarget = HelperFunctions.findAnyModel(dungeon)
	
			if currentTarget then
				emptySince = nil
	
				while currentTarget.Parent and Config.V1 == true do						
					local character = Players.LocalPlayer.Character
					local root = character and HelperFunctions.getRoot(character)
					local otherRoot = HelperFunctions.getTorso(currentTarget)
	
					if root and otherRoot then
						local distance = (root.Position - otherRoot.Position).Magnitude
	
						if distance <= 1000 then
							root.CFrame = otherRoot.CFrame * CFrame.new(Config.XOffset, Config.YOffset, Config.ZOffset)
						end
					end
					task.wait()
				end
			else
				emptySince = emptySince or os.clock()
	
				if os.clock() - emptySince >= 7 then
					HelperFunctions.restartRound()
					break
				end
				task.wait(1)
			end
		end
	end
	
	local running = false
	
	while true do
		if Config.V1 == true and not running then
			running = true
	
			task.spawn(function()
				v1()
				running = false
			end)
		end
	
		task.wait(0.1)
	end
end;
